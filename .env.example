# Copy this file to .env and replace **** with your own Azure values.
# The real .env is git-ignored. In production these are set as
# Application Settings in Azure App Service.

# Azure Cosmos DB
COSMOS_CONNECTION_STRING=****

# Azure Blob Storage
BLOB_CONNECTION_STRING=****
BLOB_CONTAINER_NAME=media

# Azure AI Language (sentiment analysis)
AZURE_SENTIMENT_KEY=****
AZURE_SENTIMENT_ENDPOINT=****

# Azure Translator
TRANSLATOR_KEY=****
TRANSLATOR_REGION=global
TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Azure Computer Vision (image captioning)
CV_KEY=****
CV_ENDPOINT=****

# JWT authentication
JWT_SECRET_KEY=****

# Flask
FLASK_ENV=production
PORT=5000
